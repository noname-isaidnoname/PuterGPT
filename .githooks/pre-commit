#!/bin/sh
# PuterGPT pre-commit verification.
#
# Runs the headless harness suite and blocks the commit when anything fails.
# Only docs/meta changes skip verification (see tools/verify-all.js --changed);
# any app code, CSS or tooling change runs the full suite against the working
# tree. Bypass in emergencies with: git commit --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=.
cd "$root" || exit 1

if ! command -v node >/dev/null 2>&1; then
    echo "[pre-commit] node not found on PATH; cannot run verification, refusing to commit." >&2
    exit 1
fi

for file in js/*.js; do
    node --check "$file" || exit 1
done

exec node tools/verify-all.js --changed
